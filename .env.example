# Copy to .env and fill in. .env is git-ignored; never commit it.

# ---------------------------------------------------------------
# Local development
# ---------------------------------------------------------------
# A Brawl Stars API key from https://developer.brawlstars.com
# The key is locked to the IP it was created for, so a key made at
# home will not work from anywhere else.
BS_API_KEY=

# ---------------------------------------------------------------
# Automated runs (CI) — not needed for local development
# ---------------------------------------------------------------
# Developer-portal credentials. In CI these are repository secrets,
# never a file. The pipeline uses them to mint a short-lived key
# scoped to the runner's own IP and revokes it when the run ends,
# so no long-lived key exists anywhere.
BS_DEV_EMAIL=
BS_DEV_PASSWORD=

# ---------------------------------------------------------------
# Publishing (optional)
# ---------------------------------------------------------------
# Hugging Face token with write access, for `bsetl-publish`.
HF_TOKEN=
