# ---------------------------------------------------------------
# Secrets — never commit credentials of any kind
# ---------------------------------------------------------------
.env
.env.*
!.env.example
local_secrets.py
**/local_secrets.py
*.pem
*.key

# ---------------------------------------------------------------
# Operational data
# Season databases and their generated sidecars are pipeline output,
# not source. See data/README.md.
# ---------------------------------------------------------------
data/*
!data/README.md
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.parquet
!tests/fixtures/**

# ---------------------------------------------------------------
# Working notes
# Design scratch, brainstorms, and implementation checklists kept
# locally. Conclusions worth publishing live in docs/.
# ---------------------------------------------------------------
notes/

# ---------------------------------------------------------------
# Editor and assistant configuration
# ---------------------------------------------------------------
.cursor/
.idea/
.vscode/

